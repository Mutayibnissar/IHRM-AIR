{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutayibnissar.github.io/IHRM-AIR/data/question.schema.json",
  "title": "IHRM Air question record",
  "description": "Versionable structure for reviewed IHRM assessment items. This schema does not certify the factual correctness of a question.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "unitId",
    "type",
    "prompt",
    "options",
    "correctOptionId",
    "explanation",
    "difficulty",
    "tags",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "unitId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "type": {
      "type": "string",
      "enum": [
        "single-choice"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1200
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "correctOptionId": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2400
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "foundation",
        "intermediate",
        "advanced"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewerNote": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,19}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "textbook",
            "academic-paper",
            "official-guidance",
            "course-material",
            "original"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "page": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    }
  }
}
